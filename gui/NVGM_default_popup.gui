types NVGM_default_popup_types {	
	type nvgm_default_popup = default_popup
	{
		layer = top
		visible = "[GetVariableSystem.Exists('show_nvgm_default_popup')]"
		blockoverride "window_header_name" {
			text = "nvgm_menu_title"
		}
		blockoverride "header_close_button_visibility" {
			visible = yes
		}
		blockoverride "header_close_button" {
			onclick = "[GetVariableSystem.Toggle('show_nvgm_default_popup')]"
		}
		blockoverride "scrollarea_content" {
			flowcontainer = {
				resizeparent = yes
				direction = vertical
				maximumsize = { 700 -1 }
				minimumsize = { 700 -1 }
			}
		}
		blockoverride "fixed_bottom" {
			flowcontainer = {
				using = default_list_position
				direction = vertical
				flowcontainer = {
					direction = horizontal
					using = default_list_position
					flowcontainer = {
						textbox = {
							raw_text = "Global Data"
							autoresize = yes
							margin = { 10 10 }
							multiline = yes
						}
						widget = {
							size = { 60 44 }
							checkbutton = {
								using = check_button
								size = { 24 24 }
								parentanchor = vcenter|left
								checked = "[GetVariableSystem.Exists('show_nvgm_data_popup')]"
								onclick = "[GetVariableSystem.Toggle('show_nvgm_data_popup')]"
								onclick = "[GetScriptedGui('nvgm_refresh_statistics_3').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							}
						}
					}
					flowcontainer = {
						textbox = {
							raw_text = "NVGM_RANKING_CHART"
							autoresize = yes
							margin = { 10 10 }
							multiline = yes
						}
						widget = {
							size = { 60 44 }
							checkbutton = {
								using = check_button
								size = { 24 24 }
								parentanchor = vcenter|left
								checked = "[GetVariableSystem.Exists('show_nvgm_ranking_chart_popup')]"
								onclick = "[GetScriptedGui('nvgm_refresh_statistics_1').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetVariableSystem.Toggle('show_nvgm_ranking_chart_popup')]"
								onclick = "[GetVariableSystem.Toggle('show_not_nvgm_1_ranking')]"
								onclick = "[GetVariableSystem.Toggle('show_not_nvgm_2_ranking')]"
								onclick = "[GetVariableSystem.Toggle('show_not_nvgm_3_ranking')]"
								onclick = "[GetVariableSystem.Toggle('show_not_nvgm_4_ranking')]"
								onclick = "[GetVariableSystem.Toggle('show_not_nvgm_5_ranking')]"
								onclick = "[GetVariableSystem.Toggle('show_not_nvgm_6_ranking')]"
								onclick = "[GetVariableSystem.Toggle('show_not_nvgm_7_ranking')]"
								onclick = "[GetVariableSystem.Toggle('show_not_nvgm_8_ranking')]"
								onclick = "[GetVariableSystem.Toggle('show_not_nvgm_9_ranking')]"
								onclick = "[GetVariableSystem.Toggle('show_not_nvgm_10_ranking')]"
								onclick = "[GetVariableSystem.Toggle('show_not_nvgm_my_ranking')]"
							}
						}
					}
					flowcontainer = {
						textbox = {
							raw_text = "Overlord & Subject Data"
							autoresize = yes
							margin = { 10 10 }
							multiline = yes
						}
						widget = {
							size = { 60 44 }
							checkbutton = {
								using = check_button
								size = { 24 24 }
								parentanchor = vcenter|left
								checked = "[GetVariableSystem.Exists('show_nvgm_subject_popup')]"
								onclick = "[GetVariableSystem.Toggle('show_nvgm_subject_popup')]"
								onclick = "[GetVariableSystem.Clear('show_nvgm_subject_popup_investment_pool')]"
								onclick = "[GetVariableSystem.Clear('show_nvgm_subject_popup_pop_strata')]"
								onclick = "[GetVariableSystem.Clear('show_nvgm_subject_popup_techs_researched')]"
								onclick = "[GetVariableSystem.Toggle('show_nvgm_subject_popup_investment_pool')]"
								onclick = "[GetScriptedGui('nvgm_refresh_statistics_2').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							}
						}
					}
				}
			}
		}
	}
	type nvgm_data_popup = default_popup
	{
		layer = top
		visible = "[GetVariableSystem.Exists('show_nvgm_data_popup')]"
		blockoverride "window_header_name" {
			text = "nvgm_global_data_title"
		}
		blockoverride "header_back_button_visibility" {
			visible = yes
		}
		blockoverride "header_close_button_visibility" {
			visible = yes
		}
    blockoverride "header_back_button" {
			onclick = "[GetVariableSystem.Clear('show_nvgm_default_popup')]"
			onclick = "[GetVariableSystem.Toggle('show_nvgm_default_popup')]"
			onclick = "[GetVariableSystem.Clear('show_nvgm_data_popup')]"
    }
		blockoverride "header_close_button" {
			onclick = "[GetVariableSystem.Clear('show_nvgm_data_popup')]"
		}
		blockoverride "scrollarea_content" {
			flowcontainer = {
				resizeparent = yes
				direction = horizontal
				maximumsize = { 1400 -1 }
				minimumsize = { 1400 -1 }
				flowcontainer = {
					direction = vertical
					datamodel = "[GetPlayer.MakeScope.GetList('nvgm_investment_pool_list')]"
					maximumsize = { 700 -1 }
					minimumsize = { 700 -1 }
					widget = {
						size = { 20 20 }
					}
					textbox = {
						parentanchor = hcenter|center
						align = center
						fontsize = 25
						raw_text = "#O Global #! [concept_investment_pool]"
					}
					widget = {
						size = { 25 25 }
					}
					item = {
						flowcontainer = {
							spacing = 5
							datacontext = "[Scope.GetCountry]"
							widget = {
								textbox = {
									position = { 80 20 }
									size = { 700 14 }
									fontsize = 17
									parentanchor = vcenter
									align = nobaseline|left
									raw_text = "[Country.GetInvestmentPool|vD]"
								}
							}
							widget = {
								textbox = {
									position = { 120 20 }
									size = { 550 14 }
									fontsize = 17
									parentanchor = vcenter
									align = nobaseline|right
									max_width = "[FixedPointToFloat(Country.MakeScope.Var('nvgm_investment_pool_var').GetValue)]"
									background = {
										texture = "gfx/interface/backgrounds/fancy_pattern_2.dds"
										color = "[Country.GetMapColor]"
										mirror = horizontal 
										using = frame_small_mask
										alpha = 1.0
										modify_texture = {
											blend_mode = add
										}
									}
								}
							}
							flowcontainer = {
								textbox = {
									raw_text = "[Country.GetFlagTextIcon]"
									autoresize = yes
									parentanchor = vcenter
									align = nobaseline
									fontsize = 30
									tooltip = "[Country.GetNameNoFlag]"	
								}
							}
						}
					}
				}
				flowcontainer = {
					direction = vertical
					datamodel = "[GetPlayer.MakeScope.GetList('nvgm_investment_rights_pool_list')]"
					maximumsize = { 700 -1 }
					minimumsize = { 700 -1 }
					widget = {
						size = { 20 20 }
					}
					textbox = {
						parentanchor = hcenter|center
						align = center
						fontsize = 25
						raw_text = "[concept_foreign_investment_rights] [concept_investment_pool]"
					}
					widget = {
						size = { 25 25 }
					}
					item = {
						flowcontainer = {
							spacing = 5
							datacontext = "[Scope.GetCountry]"
							widget = {
								textbox = {
									position = { 80 20 }
									size = { 700 14 }
									fontsize = 17
									parentanchor = vcenter
									align = nobaseline|left
									raw_text = "[Country.GetInvestmentPool|vD]"
								}
							}
							widget = {
								textbox = {
									position = { 120 20 }
									size = { 550 14 }
									fontsize = 17
									parentanchor = vcenter
									align = nobaseline|right
									max_width = "[FixedPointToFloat(Country.MakeScope.Var('nvgm_investment_rights_pool_var').GetValue)]"
									background = {
										texture = "gfx/interface/backgrounds/fancy_pattern_2.dds"
										color = "[Country.GetMapColor]"
										mirror = horizontal 
										using = frame_small_mask
										alpha = 1.0
										modify_texture = {
											blend_mode = add
										}
									}
								}
							}
							flowcontainer = {
								textbox = {
									raw_text = "[Country.GetFlagTextIcon]"
									autoresize = yes
									parentanchor = vcenter
									align = nobaseline
									fontsize = 30
									tooltip = "[Country.GetNameNoFlag]"	
								}
							}
						}
					}
				}
			}
		}
		blockoverride "fixed_bottom" {
			flowcontainer = {
				using = default_list_position
				direction = vertical
				flowcontainer = {
					textbox = {
						raw_text = "Reset"
						autoresize = yes
						margin = { 10 10 }
						multiline = yes
					}
					button_icon_reset = {
						parentanchor = vcenter|left
						tooltip = "TOOLTIP_RESET"
						onclick = "[GetScriptedGui('nvgm_refresh_statistics_3').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						size = { 24 24 }
					}
				}
			}
		}
	}
	type nvgm_ranking_chart_popup = default_popup
