							margin_top = 8
							using = fontsize_small
							block "everything_that_is_not_empty_state_visibility" {
								visible = yes
							}
							block "startdate" {
								text = "[GetOldestDate(GetPlayer.GetIncorporatedLiteracyTrend)]"
							}
						}
