types NVGM_subject_popup_types {
	type nvgm_subject_popup_investment_pool = flowcontainer
	{
		resizeparent = yes
		direction = horizontal
		maximumsize = { 700 -1 }
		minimumsize = { 700 -1 }
		position = { 0 0 }
		flowcontainer = {
			direction = vertical
			datamodel = "[GetPlayer.MakeScope.GetList('nvgm_subject_investment_pool_list')]"
			maximumsize = { 700 -1 }
			minimumsize = { 700 -1 }
			widget = {
				size = { 20 20 }
			}
			textbox = {
				parentanchor = hcenter|center
				align = center
				fontsize = 25
				raw_text = "[concept_investment_pool]"
			}
			widget = {
				size = { 25 25 }
			}
			item = {
				flowcontainer = {
					spacing = 5
					datacontext = "[Scope.GetCountry]"
					widget = {
						textbox = {
							position = { 80 20 }
							size = { 700 14 }
							fontsize = 17
							parentanchor = vcenter
							align = nobaseline|left
							raw_text = "[Country.GetInvestmentPool|vD]"
						}
					}
					widget = {
						textbox = {
							position = { 120 20 }
							size = { 550 14 }
							fontsize = 17
							parentanchor = vcenter
							align = nobaseline|right
							max_width = "[FixedPointToFloat(Country.MakeScope.Var('nvgm_subject_investment_pool_var').GetValue)]"
							background = {
								texture = "gfx/interface/backgrounds/fancy_pattern_2.dds"
								color = "[Country.GetMapColor]"
								mirror = horizontal 
								using = frame_small_mask
								alpha = 1.0
								modify_texture = {
									blend_mode = add
								}
							}
						}
					}
					flowcontainer = {
						textbox = {
							raw_text = "[Country.GetFlagTextIcon]"
							autoresize = yes
							parentanchor = vcenter
							align = nobaseline
							fontsize = 30
							tooltip = "[Country.GetNameNoFlag]"	
						}
					}
				}
			}
		}
	}
	type nvgm_subject_popup_pop_strata = flowcontainer
	{
		resizeparent = yes
		direction = horizontal
		maximumsize = { 700 -1 }
		minimumsize = { 700 -1 }
		position = { 0 0 }
		flowcontainer = {
			resizeparent = yes
			direction = vertical
			maximumsize = { 700 -1 }
			minimumsize = { 700 -1 }
			datamodel = "[GetPlayer.MakeScope.GetList('nvgm_subject_pop_strata_list')]"
			widget = {
				size = { 20 20 }
			}
			textbox = {
				parentanchor = hcenter|center
				align = center
				fontsize = 25
				raw_text = "NVGM_SUBJECT_POP_STRATA"
			}
			widget = {
				size = { 25 25 }
			}
			item = {
				flowcontainer = {
					datacontext = "[Scope.GetCountry]"
					widget = {
						textbox = {
							position = { 45 21 }
							size = { 700 14 }
							fontsize = 12
							parentanchor = vcenter
							align = nobaseline|left
							raw_text = "#O [Country.MakeScope.Var('nvgm_subject_lower_strata_value').GetValue|2] #!: #U [Country.MakeScope.Var('nvgm_subject_middle_strata_value').GetValue|2] #!: #green [Country.MakeScope.Var('nvgm_subject_upper_strata_value').GetValue|2] #!"
						}
					}
					flowcontainer = {
						textbox = {
							raw_text = "[Country.GetFlagTextIcon]"
							autoresize = yes
							parentanchor = vcenter
							align = nobaseline
							fontsize = 30
							tooltip = "[Country.GetNameNoFlag]"	
						}
					}
					widget = {
						direction = horizontal
						size = { 550 14 }
						textbox = {
							position = { 100 14 }
							size = { 550 14 }
							fontsize = 17
							parentanchor = vcenter|right
							align = nobaseline|right
							max_width = "[FixedPointToFloat(Country.MakeScope.Var('nvgm_subject_lower_strata_var').GetValue)]"
							background = {
								texture = "gfx/interface/backgrounds/fancy_pattern_2.dds"
								color = { 1.0 0.67 0.45 1.0 }
								mirror = horizontal 
								using = frame_small_mask
								alpha = 1.0
								modify_texture = {
									blend_mode = add
								}
							}
						}
						textbox = {
							position = { 100 14 }
							size = { 550 14 }
							fontsize = 17
							parentanchor = vcenter|right
							align = nobaseline|right
							max_width = "[FixedPointToFloat(Country.MakeScope.Var('nvgm_subject_middle_strata_var').GetValue)]"
							background = {
								texture = "gfx/interface/backgrounds/fancy_pattern_2.dds"
								color = { 0.41 0.67 0.74 1.0 }
								mirror = horizontal 
								using = frame_small_mask
								alpha = 1.0
								modify_texture = {
									blend_mode = add
								}
							}
						}
						textbox = {	
							# position = { 100 14 }
							size = { 550 14 }
							fontsize = 17
							parentanchor = vcenter|right
							align = nobaseline|right
							max_width = "[FixedPointToFloat(Country.MakeScope.Var('nvgm_subject_upper_strata_var').GetValue)]"	
							background = {
								texture = "gfx/interface/backgrounds/fancy_pattern_2.dds"
								color = { 0.39 0.67 0.45 1.0 }
								mirror = horizontal 
								using = frame_small_mask
								alpha = 1.0
								modify_texture = {
									blend_mode = add
								}
							}
						}
					}
				}
			}
		}
	}
	type nvgm_subject_popup_techs_researched = flowcontainer
	{
		resizeparent = yes
		direction = horizontal
		maximumsize = { 700 -1 }
		minimumsize = { 700 -1 }
		position = { 0 0 }
		flowcontainer = {
			resizeparent = yes
			direction = vertical
			maximumsize = { 700 -1 }
			minimumsize = { 700 -1 }
			datamodel = "[GetPlayer.MakeScope.GetList('nvgm_subject_techs_researched_list')]"
			widget = {
				size = { 20 20 }
			}
			textbox = {
				parentanchor = hcenter|center
				align = center
				fontsize = 25
				raw_text = "[concept_technology]"
			}
			widget = {
				size = { 25 25 }
			}
			item = {
				flowcontainer = {
					spacing = 5
					datacontext = "[Scope.GetCountry]"
					widget = {
						textbox = {
							position = { 80 20 }
							size = { 700 14 }
							fontsize = 17
							parentanchor = vcenter
							align = nobaseline|left
							raw_text = "[Country.MakeScope.Var('nvgm_subject_techs_researched_value').GetValue|v0]"
						}
					}
					widget = {
						textbox = {
							position = { 120 20 }
							size = { 550 14 }
							fontsize = 17
							parentanchor = vcenter
							align = nobaseline|right
							max_width = "[FixedPointToFloat(Country.MakeScope.Var('nvgm_subject_techs_researched_var').GetValue)]"
							background = {
								texture = "gfx/interface/backgrounds/fancy_pattern_2.dds"
								color = "[Country.GetMapColor]"
								mirror = horizontal 
								using = frame_small_mask
								alpha = 1.0
								modify_texture = {
									blend_mode = add
								}
							}
						}
					}
					flowcontainer = {
						textbox = {
							raw_text = "[Country.GetFlagTextIcon]"
							autoresize = yes
							parentanchor = vcenter
							align = nobaseline
							fontsize = 30
							tooltip = "[Country.GetNameNoFlag]"	
						}
					}
				}
			}
		}
	}
