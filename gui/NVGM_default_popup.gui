types NVGM_ranking_chart_types {
	# Top 10 GDP
	type nvgm_plotline_gdp = flowcontainer
	{
		using = default_list_position
		margin = { 5 10 }
		flowcontainer = {
			direction = vertical
			margin_bottom = 40
			margin_left = 60
			margin_right = 30
			background = {
				using = paper_bg
			}
			# header
			textbox = {
				using = default_list_position
				block "header" {
					raw_text = "NVGM_RATE_GDP"
				}
				autoresize = yes
				align = hcenter|nobaseline
				margin_top = 10
				margin_bottom = 10
				default_format = "#title"
				multiline = yes
				maximumsize = { 700 -1 }
			}
			# graph
			widget = {
				block "size" {
					size = { 560 200 }
				}
				block "empty_state" {
					textbox = {
						block "empty_state_visibility" {
							visible = no
						}
						block "empty_state_text" {
							raw_text = "#todo nothing to see here#!"
						}
						parentanchor = center
						align = hcenter|nobaseline
					}
				}
				background = {
					texture = "gfx/interface/graph/graph_frame.dds"
					spriteType = Corneredtiled
					spriteborder = { 2 2 }
					texture_density = 2
					margin = { 4 4 }
					alpha = 0.85
					modify_texture = {
						texture = "gfx/interface/backgrounds/default_bg_shading.dds"
						spriteType = Corneredstretched
						spriteborder = { 0 0 }
						blend_mode = overlay
						alpha = 0.7
					}
				}
				# 1位
				widget = {
					size = { 100% 100% }
					block "datamodel" {}
					block "everything_that_is_not_empty_state_visibility" {}
					block "singleitem" {
						plotline = {
							size = { 100% 100% }
							using = plot_line
							width = 3.5
							block "line_color" {
								color = { 1.0 0.4 0.4 1.0 }
							}
							block "tooltip" {}
							block "line_plotpoints" {
								visible = "[And(Not(IsEmpty(GetGlobalVariable('nvgm_1_gdp_country_gvar').GetCountry.GetGDPTrend)),GetVariableSystem.Exists('show_not_nvgm_1_ranking'))]"
								plotpoints = "[GetTrendPlotPointsNormalized(GetGlobalVariable('nvgm_1_gdp_country_gvar').GetCountry.GetGDPTrend, '(CFixedPoint)0', GetMax(GetGlobalVariable('nvgm_1_gdp_country_gvar').GetCountry.GetGDPTrend) )]"
							}
						}
					}
					block "extra_plotlines" {}
				}
				# 2位
				widget = {
					size = { 100% 100% }
					block "datamodel" {}
					block "everything_that_is_not_empty_state_visibility" {}
