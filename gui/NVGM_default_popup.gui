	# Top 10 Expenses
	type nvgm_plotline_expenses = flowcontainer
	{
		using = default_list_position
		margin = { 10 10 }
		flowcontainer = {
			direction = vertical
			margin_bottom = 40
			margin_left = 60
			margin_right = 30
			background = {
				using = paper_bg
			}
			# header
			textbox = {
				using = default_list_position
				block "header" {
					raw_text = "NVGM_RATE_EXPENSES"
				}
				autoresize = yes
				align = hcenter|nobaseline
				margin_top = 10
				margin_bottom = 10
				default_format = "#title"
				multiline = yes
				maximumsize = { 700 -1 }
			}
			# graph
			widget = {
				block "size" {
					size = { 560 200 }
				}
				block "empty_state" {
					textbox = {
						block "empty_state_visibility" {
							visible = no
						}
						block "empty_state_text" {
							raw_text = "#todo nothing to see here#!"
						}
						parentanchor = center
						align = hcenter|nobaseline
					}
				}
				background = {
					texture = "gfx/interface/graph/graph_frame.dds"
					spriteType = Corneredtiled
					spriteborder = { 2 2 }
					texture_density = 2
					margin = { 4 4 }
					alpha = 0.85
					modify_texture = {
						texture = "gfx/interface/backgrounds/default_bg_shading.dds"
						spriteType = Corneredstretched
						spriteborder = { 0 0 }
						blend_mode = overlay
						alpha = 0.7
					}
				}
				# 1位
				widget = {
					size = { 100% 100% }
					block "datamodel" {}
					block "everything_that_is_not_empty_state_visibility" {}
