								plotpoints = "[GetTrendPlotPointsNormalized(GetGlobalVariable('nvgm_2_gdp_country_gvar').GetCountry.GetGDPTrend, '(CFixedPoint)0', GetMax(GetGlobalVariable('nvgm_1_gdp_country_gvar').GetCountry.GetGDPTrend) )]"
							}
